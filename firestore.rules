rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Datos del negocio (dirección, teléfono, redes, horarios)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Platos del menú
    match /menu/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

  }
}
