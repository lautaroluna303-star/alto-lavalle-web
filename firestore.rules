rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Solo el mail del dueño puede escribir
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'restoaltolavalle@gmail.com';
    }

    // Datos del negocio (dirección, teléfono, redes, horarios)
    match /config/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Platos del menú
    match /menu/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

  }
}
